---
interface Props { value: string; label?: string }
const { value, label = 'Kopiér' } = Astro.props;
---
<div class="copyline">
  <code>{value}</code>
  <button type="button" data-copy={value} aria-label={`Kopiér ${value}`}>{label}</button>
</div>

<style>
  .copyline {
    display: flex;
    align-items: stretch;
    border: 1.5px solid var(--ink);
    border-radius: var(--radius);
    background: var(--sheet);
    max-width: 100%;
    min-width: 0;
    overflow: hidden;
  }
  code {
    background: none !important;
    padding: 0.7rem 0.9rem !important;
    font-size: 0.9rem;
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    white-space: nowrap;
    overflow-wrap: normal !important;
    scrollbar-width: none;
  }
  button {
    font: 600 var(--t-sm) / 1 var(--font);
    border: 0;
    border-left: 1.5px solid var(--ink);
    background: var(--ink);
    color: var(--fog);
    padding: 0 1rem;
    cursor: pointer;
    flex: none;
  }
  button[data-done] {
    background: var(--d-natur);
  }
</style>
