---
import Base from '../../../layouts/Base.astro';
import CodeBlock from '../../../components/CodeBlock.astro';
import CopyLine from '../../../components/CopyLine.astro';
import Tabs from '../../../components/Tabs.astro';
import HistoryStrip from '../../../components/HistoryStrip.astro';
import kommuneData from '../../../data/kommuner.json';
import {
  datasets,
  sourceOf,
  shortTitle,
  fmtInt,
  fmtBytes,
  fmtDate,
  geomNames,
  datasetUrl,
  descriptionOf,
  type Dataset,
} from '../../../lib/catalog';
import { renderMarkdown, plainText } from '../../../lib/markdown';
import { toUtm32 } from '../../../lib/utm';

export function getStaticPaths() {
  return datasets.map((d) => ({ params: { schema: d.schema, relation: d.relation }, props: { d } }));
}

const { d } = Astro.props as { d: Dataset };
const src = sourceOf(d.schema);
const desc = descriptionOf(d);
const siblings = datasets.filter((x) => x.schema === d.schema && x.id !== d.id);
const pq = d.assets.parquet;
const fgb = d.assets.fgb;
const geom = d.geometry?.column;
const isUtm = d.srs === 'EPSG:25832';

// Udstrækning på oversigtskortet (koordinater i UTM32 / 100, y vendt)
let extent: { x: number; y: number; w: number; h: number } | null = null;
// Nogle kilder har defekte bbox'e; tegn kun udstrækninger, der ligger i Danmark
const inDk = (b: number[]) => b[0] > 7 && b[2] < 16 && b[1] > 54 && b[3] < 58.5;
if (d.bbox && d.geometry && inDk(d.bbox)) {
  const [a, b, c, e] = d.bbox;
  const pts = [toUtm32(a, b), toUtm32(c, e), toUtm32(a, e), toUtm32(c, b)];
  const xs = pts.map((p) => p[0] / 100);
  const ys = pts.map((p) => -p[1] / 100);
  const x = Math.min(...xs);
  const y = Math.min(...ys);
  extent = { x, y, w: Math.max(...xs) - x, h: Math.max(...ys) - y };
}
const [vx, vy, vw, vh] = kommuneData.viewBox.split(' ').map(Number);
// Dækker datasættet det meste af landet, farves hele omridset i stedet for en ramme
const national = extent != null && extent.w * extent.h > 0.5 * vw * vh;

const rel = `'${d.schema}', '${d.relation}'`;
const sampleCols = d.columns
  .filter((c) => !c.type.startsWith('geometry') && !/^(gid|datafordeler|registrering|virkning|forretnings|id_namespace|objectid|gml_id)/.test(c.name))
  .slice(0, 4)
  .map((c) => c.name);

const duck = `-- Kør scripts/duckdb/init.sql én gang (se "Kom i gang") for dk()-makroen
SELECT ${sampleCols.join(', ') || '*'}${geom ? `,\n       ${geom}` : ''}
FROM dk(${rel})
LIMIT 10;`;

// Til SQL-editoren i browseren: geometri som tekst, så den kan læses i tabellen
const liveSql = `SELECT ${sampleCols.join(', ') || '*'}${geom ? `,\n       ST_AsText(${geom}) AS geometri` : ''}
FROM dk(${rel})
LIMIT 100;`;

const duckRaw = `INSTALL spatial; LOAD spatial;
INSTALL httpfs;  LOAD httpfs;
SET s3_region = 'eu-west-1';

-- Præcis dette snapshot (${d.latest})
SELECT count(*) FROM '${pq?.s3}';

-- Alle snapshots på én gang: datoen bliver en kolonne
SELECT _gc2_snapshot_date, count(*)
FROM '${d.s3Prefix}*/*.parquet'
GROUP BY ALL ORDER BY 1;`;

const py = fgb
  ? `import geopandas as gpd

# FlatGeobuf har et rumligt indeks, så kun det valgte område hentes
url = "${fgb.http}"
gdf = gpd.read_file(url, bbox=(720000, 6170000, 730000, 6180000))  # København, EPSG:25832

# Hele datasættet som GeoParquet
from pyarrow import fs
gdf = gpd.read_parquet(
    "${pq?.s3.replace('s3://', '')}",
    filesystem=fs.S3FileSystem(anonymous=True, region="eu-west-1"),
)`
  : `import pandas as pd
from pyarrow import fs

df = pd.read_parquet(
    "${pq?.s3.replace('s3://', '')}",
    filesystem=fs.S3FileSystem(anonymous=True, region="eu-west-1"),
)`;

const gdal = fgb
  ? `# Info om laget direkte over HTTP
ogrinfo -so -al /vsicurl/${fgb.http}

# Klip et område ud og gem som GeoPackage
ogr2ogr -f GPKG ${d.relation}.gpkg \\
  -spat 720000 6170000 730000 6180000 \\
  /vsicurl/${fgb.http}`
  : `# Kræver GDAL med Parquet-driveren (GDAL 3.5+)
ogr2ogr -f CSV ${d.relation}.csv /vsicurl/${pq?.http}`;

// Historik
const hist = [...d.history].sort((a, b) => b.date.localeCompare(a.date));
const oldest = hist.at(-1)!;
const keyCol = ['id_lokalid', 'planid', 'objekt_id', 'cvrnummer', 'pnummer', 'id', 'gml_id', 'gid'].find((k) =>
  d.columns.some((c) => c.name === k),
);
const sign = (n: number) => (n > 0 ? `+${fmtInt(n)}` : n < 0 ? `−${fmtInt(-n)}` : '±0');

const timeSql = `-- Datasættet, som det så ud på en bestemt dato
SELECT count(*) FROM dk_at(${rel}, '${oldest.date}');

-- Rækker pr. snapshot
SELECT _gc2_snapshot_date AS dato, count(*) AS rækker
FROM dk_alle(${rel})
GROUP BY ALL ORDER BY dato;${
  keyCol
    ? `

-- Hvad er kommet til, og hvad er forsvundet siden ${oldest.date}?
SELECT 'ny' AS ændring, * EXCLUDE (_gc2_snapshot_date)
FROM dk(${rel})
ANTI JOIN dk_at(${rel}, '${oldest.date}') USING (${keyCol})
UNION ALL BY NAME
SELECT 'fjernet' AS ændring, * EXCLUDE (_gc2_snapshot_date)
FROM dk_at(${rel}, '${oldest.date}')
ANTI JOIN dk(${rel}) USING (${keyCol});`
    : ''
}`;

const typeName = (t: string) =>
  t.startsWith('geometry') ? t.replace('geometry', 'geometry ') : t.replace('character varying', 'tekst').replace('timestamp with time zone', 'tidsstempel');
---
<Base title={d.title} description={desc ? plainText(desc) : `${d.title}: ${fmtInt(d.rows)} rækker som GeoParquet${fgb ? ' og FlatGeobuf' : ''}. Kilde: ${src.full} (${src.owner}).`}>
  <div class="wrap page">
    <nav class="crumbs" aria-label="Brødkrummer">
      <a href="/data/">Data</a>
      <span aria-hidden="true">/</span>
      <a href={`/data/?kilde=${d.schema}`}>{src.name}</a>
    </nav>

    <header class="head">
      <div>
        <p class="source" data-domain={src.domain}>
          <span class="swatch" />
          {src.full}, {src.owner}
        </p>
        <h1>{shortTitle(d)}</h1>
        <code class="dsid">{d.id}</code>
        {desc && <div class:list={['desc', { long: desc.length > 280 }]} set:html={renderMarkdown(desc)} />}
      </div>
      {extent && (
        <svg class:list={['extent', { national }]} viewBox={`${vx - 80} ${vy - 80} ${vw + 160} ${vh + 160}`} role="img" aria-label={national ? "Datasættet dækker hele landet" : "Datasættets udstrækning på Danmarkskortet"}>
          <path d={kommuneData.outline} />
          {!national && <rect
            x={extent.x}
            y={extent.y}
            width={Math.max(extent.w, 30)}
            height={Math.max(extent.h, 30)}
          />}
        </svg>
      )}
    </header>

    <dl class="facts">
      <div><dt>Rækker</dt><dd class="num">{fmtInt(d.rows)}</dd></div>
      <div><dt>Geometri</dt><dd>{d.geometry ? `${geomNames[d.geometry.type] ?? d.geometry.type} (${d.geometry.type})` : 'Ingen, ren tabel'}</dd></div>
      <div><dt>Koordinatsystem</dt><dd>{d.srs ?? 'Ikke relevant'}</dd></div>
      <div><dt>Seneste snapshot</dt><dd>{fmtDate(d.latest)}</dd></div>
      <div><dt>Historik</dt><dd><a href="#historik">{d.snapshots.length === 1 ? '1 snapshot' : `${d.snapshots.length} snapshots`}</a></dd></div>
      <div><dt>Kolonner</dt><dd class="num">{d.columns.length}</dd></div>
    </dl>

    <section class="block history" id="historik">
      <div class="history-head">
        <h2>Historik</h2>
        <p class="muted">
          {hist.length > 1
            ? `Datasættet findes i ${hist.length} snapshots fra ${fmtDate(oldest.date)} til ${fmtDate(d.latest)}. Alle snapshots bliver liggende, så du kan læse data, som de så ud på en given dato.`
            : `Datasættet har ét snapshot indtil videre, fra ${fmtDate(d.latest)}. Nye snapshots lægges ved siden af, og det gamle bliver liggende, så historikken vokser herfra.`}
        </p>
      </div>
      <HistoryStrip dataset={d} />
      <div class="history-body">
        <div class="table-scroll">
          <table class="data snaps">
            <thead>
              <tr><th>Snapshot</th><th class="n">Rækker</th><th class="n">Ændring</th><th>Metadata</th></tr>
            </thead>
            <tbody>
              {hist.map((h, i) => {
                const prev = hist[i + 1]?.rows;
                const delta = prev != null && h.rows != null ? h.rows - prev : null;
                return (
                  <tr>
                    <td>{fmtDate(h.date)}{i === 0 && <span class="muted"> (nyeste)</span>}</td>
                    <td class="n">{fmtInt(h.rows)}</td>
                    <td class:list={['n', { changed: delta }]}>{delta == null ? '' : sign(delta)}</td>
                    <td><a href={`${d.httpPrefix}_gc2_snapshot_date=${h.date}/item.json`}>item.json</a></td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
        <CodeBlock code={timeSql} caption="Gå tilbage i tid med DuckDB" />
      </div>
    </section>

    <section class="block">
      <h2>Filer</h2>
      <ul class="files">
        {pq && (
          <li>
            <div class="file-meta">
              <strong>GeoParquet</strong>
              <span class="muted num">{fmtBytes(pq.size)}</span>
              <a href={pq.http} download>Download</a>
            </div>
            <CopyLine value={pq.s3} />
          </li>
        )}
        {fgb && (
          <li>
            <div class="file-meta">
              <strong>FlatGeobuf</strong>
              <span class="muted num">{fmtBytes(fgb.size)}</span>
              <a href={fgb.http} download>Download</a>
            </div>
            <CopyLine value={fgb.http} />
          </li>
        )}
      </ul>
      <p class="note muted">
        Filnavnene skifter ved hvert snapshot. Brug stien med jokertegn (<code>{d.s3Prefix}*/*.parquet</code>) eller
        slå den nyeste fil op i <a href={`${d.httpPrefix}latest.json`}>latest.json</a>. STAC-beskrivelsen ligger i{' '}
        <a href={`${d.httpPrefix}collection.json`}>collection.json</a>.
      </p>
    </section>

    <section class="block">
      <h2>Brug datasættet</h2>
      <Tabs id="use" labels={['DuckDB', 'DuckDB uden makro', 'Python', 'QGIS', 'GDAL']}>
        <div role="tabpanel">
          <CodeBlock code={duck} />
          <p class="try" data-live-only>
            <a class="btn ghost" href={`/sql/#q=${encodeURIComponent(liveSql)}`}>Prøv datasættet i browseren</a>
          </p>
        </div>
        <div role="tabpanel"><CodeBlock code={duckRaw} /></div>
        <div role="tabpanel"><CodeBlock code={py} lang="python" /></div>
        <div role="tabpanel" class="prose">
          {fgb ? (
            <ol>
              <li>Vælg <strong>Lag › Tilføj lag › Tilføj vektorlag</strong>.</li>
              <li>Sæt kildetype til <strong>Protokol: HTTP(S), cloud osv.</strong></li>
              <li>Indsæt URL'en og tryk <strong>Tilføj</strong>:</li>
            </ol>
          ) : (
            <p>Datasættet har ingen geometri. I QGIS kan GeoParquet-filen åbnes som tabel, hvis din QGIS har GDAL's Parquet-driver.</p>
          )}
          <CopyLine value={fgb ? fgb.http : pq!.http} />
          {fgb && (
            <p class="muted">
              FlatGeobuf har et rumligt indeks, så QGIS henter kun de features, der er i kortudsnittet. Det er derfor
              hurtigt, også for store lag. GeoParquet virker også i QGIS 3.34+, hvis din GDAL har Parquet-driveren.
            </p>
          )}
        </div>
        <div role="tabpanel"><CodeBlock code={gdal} lang="bash" /></div>
      </Tabs>
    </section>

    <div class="two">
      <section class="block">
        <h2>Kolonner</h2>
        <div class="table-scroll cols">
          <table class="data">
            <thead><tr><th>Navn</th><th>Type</th></tr></thead>
            <tbody>
              {d.columns.map((c) => (
                <tr>
                  <td><code>{c.name}</code></td>
                  <td class="muted">{typeName(c.type)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {!isUtm && d.geometry && <p class="muted note">Bemærk: dette datasæt ligger i {d.srs}.</p>}
      </section>

      <aside class="block">
        {siblings.length > 0 && (
          <>
            <h2>Andre datasæt fra {src.name}</h2>
            <ul class="sibs">
              {siblings.slice(0, 14).map((s) => (
                <li><a href={datasetUrl(s)}>{shortTitle(s)}</a></li>
              ))}
            </ul>
            {siblings.length > 14 && <a href={`/data/?kilde=${d.schema}`}>Alle {siblings.length + 1} datasæt</a>}
          </>
        )}
      </aside>
    </div>
  </div>
</Base>

<style>
  .page {
    padding-top: 1.5rem;
  }
  .crumbs {
    display: flex;
    gap: 0.5rem;
    font-size: var(--t-sm);
    color: var(--ink-3);
  }
  .crumbs a {
    color: var(--ink-2);
  }
  .head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 11rem;
    gap: 2rem;
    align-items: end;
    margin: 1.75rem 0 1.5rem;
  }
  .source {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink-2);
    font-size: var(--t-sm);
    margin-bottom: 0.6rem;
  }
  h1 {
    font-size: var(--t-2xl);
    letter-spacing: -0.03em;
    margin-bottom: 0.4rem;
    overflow-wrap: anywhere;
    hyphens: auto;
  }
  .dsid {
    color: var(--ink-3);
  }
  .desc {
    margin-top: 1.25rem;
    max-width: 68ch;
    line-height: 1.6;
    color: var(--ink-2);
  }
  /* Korte beskrivelser står som ingress; lange i brødtekststørrelse, så de ikke fylder for meget */
  .desc :global(p:first-child) {
    font-size: var(--t-lg);
    line-height: 1.5;
    color: var(--ink);
  }
  .desc.long :global(p:first-child) {
    font-size: var(--t-md);
    line-height: 1.6;
  }
  .desc :global(p) {
    margin: 0 0 0.75em;
  }
  .desc :global(p:last-child) {
    margin-bottom: 0;
  }
  .desc :global(ul),
  .desc :global(ol) {
    padding-left: 1.25rem;
    margin: 0 0 0.75em;
  }
  .extent {
    width: 100%;
    height: auto;
  }
  .extent path {
    fill: var(--land);
  }
  .extent.national path {
    fill: color-mix(in srgb, var(--matrikel) 30%, var(--land));
  }
  .extent rect {
    fill: color-mix(in srgb, var(--matrikel) 12%, transparent);
    stroke: var(--matrikel);
    vector-effect: non-scaling-stroke;
    stroke-width: 2;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 1rem 2rem;
    margin: 0;
    padding: 1.25rem 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .facts dt {
    font-size: var(--t-xs);
    color: var(--ink-3);
  }
  .facts dd {
    margin: 0;
    font-weight: 650;
  }
  .block {
    margin-top: 2.75rem;
    min-width: 0;
  }
  .block h2 {
    font-size: var(--t-lg);
  }
  .try {
    margin: 0.9rem 0 0;
  }
  .files li {
    min-width: 0;
  }
  .files {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .file-meta {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    margin-bottom: 0.4rem;
    font-size: var(--t-sm);
  }
  .note {
    font-size: var(--t-sm);
    margin-top: 1rem;
    max-width: 75ch;
  }
  .prose ol {
    padding-left: 1.25rem;
    margin: 0 0 1rem;
  }
  .prose p {
    margin-top: 1rem;
    max-width: 70ch;
    font-size: var(--t-sm);
  }
  .two {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: 3rem;
  }
  .cols {
    max-height: 32rem;
    overflow: auto;
  }
  .cols code {
    background: none;
    padding: 0;
    font-size: 0.82rem;
  }
  .history-head p {
    max-width: 70ch;
  }
  .history-body {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 2rem;
    margin-top: 1.75rem;
    align-items: start;
  }
  .snaps .changed {
    color: var(--matrikel);
    font-weight: 650;
  }
  .sibs {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    display: grid;
    gap: 0.35rem;
    font-size: var(--t-sm);
  }
  @media (max-width: 860px) {
    .history-body {
      grid-template-columns: minmax(0, 1fr);
    }
    .two {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
    .head {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }
    .extent {
      width: 7rem;
      order: -1;
    }
  }
</style>
